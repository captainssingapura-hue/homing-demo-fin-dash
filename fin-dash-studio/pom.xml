<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.captainssingapura-hue.homing.findash</groupId>
        <artifactId>homing-demo-fin-dash</artifactId>
        <version>LOCAL-SNAPSHOT</version>
    </parent>

    <artifactId>fin-dash-studio</artifactId>

    <name>fin-dash-studio</name>
    <description>The umbrella: one landing over every persona workspace, the dashboard
        server (8100), and the conformance home — shared config (extended RISK_MODEL
        policy over all persona crates), the build-time report export, the conformance
        studio server (8101), and the build-fail gate test.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-studio-starter</artifactId>
        </dependency>
        <!-- Conformance studio (compile scope): lets the demo BOTH gate (test) and
             serve its own conformance studio (main). -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-conformance-studio</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.findash</groupId>
            <artifactId>fin-dash-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.findash</groupId>
            <artifactId>fin-dash-book</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.findash</groupId>
            <artifactId>fin-dash-trader</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.findash</groupId>
            <artifactId>fin-dash-etrading</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.findash</groupId>
            <artifactId>fin-dash-sales</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.findash</groupId>
            <artifactId>fin-dash-marketdata</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.findash</groupId>
            <artifactId>fin-dash-quant</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.findash</groupId>
            <artifactId>fin-dash-risk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.findash</groupId>
            <artifactId>fin-dash-governance</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.findash</groupId>
            <artifactId>fin-dash-middleoffice</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.findash</groupId>
            <artifactId>fin-dash-ipv</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.findash</groupId>
            <artifactId>fin-dash-platform</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.findash</groupId>
            <artifactId>fin-dash-audit</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.findash</groupId>
            <artifactId>fin-dash-summary</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <!-- RFC 0044 — export the demo's conformance report at process-classes into
                 target/classes/conformance-report, where the conformance studio reads it.
                 Uses the extended RISK_MODEL policy (FinDashConformanceExport).
                 classpathScope=compile is deliberate here (never sees test resources). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>export-fin-dash-conformance-report</id>
                        <phase>process-classes</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>hue.captains.singapura.js.homing.findash.studio.conformance.FinDashConformanceExport</mainClass>
                            <arguments>
                                <argument>${project.build.outputDirectory}/conformance-report</argument>
                            </arguments>
                            <classpathScope>compile</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
