<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.captainssingapura-hue.homing.findash</groupId>
    <artifactId>homing-demo-fin-dash</artifactId>
    <version>LOCAL-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>homing-demo-fin-dash</name>
    <description>FX options risk-management demo on the homing workspace, with RFC 0044 conformance.
        Multi-module: one Maven module (one Crate, one workspace kind) per human actor in the
        UI Requirements Study, plus fin-dash-core (shared primitives + headless models) and
        fin-dash-studio (the umbrella server + conformance gate/studio).</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The homing framework version. A published release; RFC 0044 conformance
             ships from 0.7.0 onwards. Set to LOCAL-SNAPSHOT to build against the
             framework working tree instead (run `mvn -o install` in homing-ssjs-core
             first) — needed when validating an unreleased core change downstream. -->
        <homing.core.version>0.8.3</homing.core.version>
        <junit.version>5.11.3</junit.version>
        <!-- One Jackson for the whole tree; see the managed dependencies. -->
        <jackson.version>2.17.2</jackson.version>
        <jontology.version>0.0.1</jontology.version>
        <!-- The Relation Grid reactor (RFC 0050 · Episode 2): a separate repo,
             homing-rel-grid, under the homing.ssjs group id. The risk ladder's
             group build runs on it; LOCAL-SNAPSHOT to build against its working
             tree, as with the core above. -->
        <relgrid.version>0.1.1</relgrid.version>
    </properties>

    <modules>
        <module>fin-dash-core</module>
        <module>fin-dash-data</module>
        <module>fin-dash-ontology</module>
        <module>fin-dash-book</module>
        <module>fin-dash-viz</module>
        <module>fin-dash-trader</module>
        <module>fin-dash-etrading</module>
        <module>fin-dash-sales</module>
        <module>fin-dash-marketdata</module>
        <module>fin-dash-quant</module>
        <module>fin-dash-risk</module>
        <module>fin-dash-governance</module>
        <module>fin-dash-middleoffice</module>
        <module>fin-dash-ipv</module>
        <module>fin-dash-platform</module>
        <module>fin-dash-audit</module>
        <module>fin-dash-summary</module>
        <module>fin-dash-studio</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.captainssingapura-hue.homing.js</groupId>
                <artifactId>homing-studio-starter</artifactId>
                <version>${homing.core.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.captainssingapura-hue.homing.js</groupId>
                <artifactId>homing-conformance-rules</artifactId>
                <version>${homing.core.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.captainssingapura-hue.homing.js</groupId>
                <artifactId>homing-conformance-studio</artifactId>
                <version>${homing.core.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.captainssingapura-hue.homing.js</groupId>
                <artifactId>homing-relation-grid</artifactId>
                <version>${homing.core.version}</version>
            </dependency>
            <!-- One dependency brings the reactor whole: rel-grid, and through
                 it the channel, the protocol and the selection. -->
            <dependency>
                <groupId>io.github.captainssingapura-hue.homing.ssjs</groupId>
                <artifactId>rel-grid-group</artifactId>
                <version>${relgrid.version}</version>
            </dependency>
            <!-- The GraalJS fixtures the widget sweep runs on (KT.md §7e).
                 Test scope, same release train as everything above. -->
            <dependency>
                <groupId>io.github.captainssingapura-hue.homing.js</groupId>
                <artifactId>homing-ssjs-test-fixtures</artifactId>
                <version>${homing.core.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- jOntology: the entity-graph markers fin-dash-data is declared
                 with, and the build-time gate that checks them. -->
            <dependency>
                <groupId>io.github.captainssingapura-hue.lang.ontology</groupId>
                <artifactId>core</artifactId>
                <version>${jontology.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.captainssingapura-hue.lang.ontology</groupId>
                <artifactId>enforcing-utils</artifactId>
                <version>${jontology.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>io.github.captainssingapura-hue.lang.ontology</groupId>
                <artifactId>enforcer</artifactId>
                <version>${jontology.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- Jackson arrives twice through vert.x 4.5.11: vertx-web brings
                 databind 2.17.2, vertx-core brings core 2.16.1, and nearest-wins
                 keeps both. databind 2.17 calls JsonParser.getNumberTypeFP(),
                 which core 2.16 lacks — so parsing any JSON with a floating-point
                 number threw NoSuchMethodError. The desk only ever encoded JSON,
                 so nothing noticed until the widget sweep parsed an action's
                 answer. One version for the three, managed here. -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>${jackson.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <!-- Pinned so the build does not vary with the Maven on the
                     machine. These four otherwise resolve from the super-POM,
                     which differs between Maven versions; the values here are
                     the ones Maven 3.9.14 supplied, so pinning changed nothing
                     at the time it was done. maven-resources-plugin matters
                     most: fin-dash-studio declares it to copy docs/ into the
                     jar, and a declaration without a version is the case
                     Maven itself warns about. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Dependency convergence, enforced. vert.x 4.5.11 once brought two
                 Jackson versions into the same classpath and nothing said so
                 until a test parsed a float (KT.md §9.9). This fails the build
                 on the next split instead. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>converge</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
