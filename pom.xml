<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.captainssingapura-hue.homing.findash</groupId>
    <artifactId>homing-demo-fin-dash</artifactId>
    <version>LOCAL-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>homing-demo-fin-dash</name>
    <description>Financial risk-management dashboard demo on the homing workspace, with RFC 0044 conformance.
        Scaffold — see KT.md. Built by a downstream agent from the FX Options UI Requirements Study.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The homing framework version. LOCAL-SNAPSHOT = the locally-built framework
             in ~/.m2 (RFC 0044 conformance-studio must be installed: run `mvn -o install`
             in homing-ssjs-core). Switch to a published release once one ships RFC 0044. -->
        <homing.core.version>LOCAL-SNAPSHOT</homing.core.version>
        <junit.version>5.11.3</junit.version>
    </properties>

    <dependencies>
        <!-- The serving stack (workspace + studio-base + server, transitively). -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-studio-starter</artifactId>
            <version>${homing.core.version}</version>
        </dependency>

        <!-- Conformance studio (compile scope): lets the demo BOTH gate (test) and
             serve its own conformance studio (main). Drags in the engine + rules +
             core + the workspace/shell crates transitively. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-conformance-studio</artifactId>
            <version>${homing.core.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- RFC 0044 — export the demo's conformance report at process-classes into
                 target/classes/conformance-report, where the conformance studio reads it.
                 Uses the extended RISK_MODEL policy (FinDashConformanceExport). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>export-fin-dash-conformance-report</id>
                        <phase>process-classes</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>hue.captains.singapura.js.homing.findash.conformance.FinDashConformanceExport</mainClass>
                            <arguments>
                                <argument>${project.build.outputDirectory}/conformance-report</argument>
                            </arguments>
                            <classpathScope>compile</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
